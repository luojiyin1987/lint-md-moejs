{
  "name": "lint-md-moejs-compat-probe",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild entry.ts --bundle --platform=neutral --format=esm --target=es2022 --alias:path=./shims/path.ts --alias:process=./shims/process.ts --alias:url=./shims/url.ts --outfile=dist/lint-md.mjs",
    "compare": "node compare.mjs",
    "compare:fix": "node compare-fix.mjs"
  },
  "dependencies": {
    "@lint-md/core": "2.5.3"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
