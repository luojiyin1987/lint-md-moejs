{
  "name": "lint-md-moejs-compat-probe",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild entry.ts --bundle --platform=neutral --format=esm --target=es2022 --alias:path=./shims/path.ts --alias:process=./shims/process.ts --alias:url=./shims/url.ts --outfile=dist/lint-md.mjs",
    "compare": "node compare.mjs",
    "compare:fix": "node compare-fix.mjs",
    "bench:smoke": "node ../bench/compare.mjs --smoke",
    "bench": "node ../bench/compare.mjs",
    "bench:scale": "node ../bench/compare.mjs --scale",
    "bench:gc": "node ../bench/gc-sweep.mjs",
    "bench:gc:smoke": "node ../bench/gc-sweep.mjs --smoke"
  },
  "dependencies": {
    "@lint-md/core": "2.5.3",
    "@lint-md/parser": "0.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
